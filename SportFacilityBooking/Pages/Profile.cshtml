@page
@model SportFacilityBooking.Pages.ProfileModel
@{
    ViewData["Title"] = "Profielpagina";
}
<h2>Welkom, @Model.Firstname!</h2>

<h3>Jouw reserveringen</h3>
@if (Model.Reservations.Count == 0)
{
    <p>Je hebt nog geen reserveringen.</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Datum</th>
                <th>Faciliteit</th>
                <th>Tijdslot</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var r in Model.Reservations)
            {
                <tr>
                    <td>@r.ReservationDate.ToShortDateString()</td>
                    <td>@r.BookedSportFacility.Name</td>
                    <td>@r.BookedTimeSlot.Starttime.ToShortTimeString() - @r.BookedTimeSlot.Endtime.ToShortTimeString()</td>
                </tr>
            }
        </tbody>
    </table>
}
