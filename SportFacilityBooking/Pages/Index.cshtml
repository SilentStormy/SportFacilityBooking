@page
@model IndexModel
@{
    ViewData["Title"] = "Overzicht Sportfaciliteiten";
}

<h1 class="text-center mb-4">Sportfaciliteiten</h1>

<div class="facility-grid">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success" style="max-width: 600px;">
            @TempData["SuccessMessage"]
        </div>
    }
    @foreach (var facility in Model.SportFacilities)
    {
        <div class="facility-card">
            <img src="/images/default-facility.jpg" alt="Facility image" />
            <div class="facility-info">
                <h3>@facility.Name</h3>
                <p><strong>Type:</strong> @facility.Type</p>
                <p>@facility.Description</p>
                <p><strong>Capaciteit:</strong> @facility.Capacity</p>
                <a class="btn btn-primary" asp-page="/SportFacilityDetails" asp-route-id="@facility.SportFacilityId">
                    Bekijk details
                </a>
            </div>
        </div>
    }
</div>
<style>
    .facility-grid {
        display: flex;
        flex-wrap: wrap;
        gap: 20px;
        justify-content: center;
    }

    .facility-card {
        background: #fff;
        border: 1px solid #ddd;
        border-radius: 8px;
        width: 300px;
        box-shadow: 0 2px 5px rgba(0,0,0,0.1);
        overflow: hidden;
        display: flex;
        flex-direction: column;
    }

        .facility-card img {
            width: 100%;
            height: 180px;
            object-fit: cover;
        }

    .facility-info {
        padding: 15px;
    }

        .facility-info h3 {
            margin-top: 0;
        }

        .facility-info .btn {
            margin-top: 10px;
        }
</style>
