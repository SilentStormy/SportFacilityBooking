@page
@model SportFacilityBooking.Pages.IndexModel
@{
    ViewData["Title"] = "Sport Facilities";
}

<h1>Available Sport Facilities</h1>

@if (Model.SportFacilities != null && Model.SportFacilities.Any())
{
    <table class="table">
        <thead>
            <tr>
                <th>Name</th>
                <th>Type</th>
                <th>Description</th>
                <th>Capacity</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var facility in Model.SportFacilities)
            {
                <tr>
                    <td>@facility.Name</td>
                    <td>@facility.Type</td>
                    <td>@facility.Description</td>
                    <td>@facility.Capacity</td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <p>No sport facilities found.</p>
}
